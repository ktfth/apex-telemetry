          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        }
      },
      "description": "Quantas respostas vieram do armazém PostgreSQL e quantas da consulta ao vivo à OpenF1. Não existe terceira origem."
    },
    {
