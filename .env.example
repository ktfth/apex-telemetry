# ApexTelemetry — variáveis de ambiente.
# Copie para .env e ajuste. O .env real é ignorado pelo git.

# ─── Gateway e ingestão ────────────────────────────────────────────────────────
# Sem esta variável o gateway consulta a OpenF1 ao vivo e a ingestão só arquiva
# em disco. Com ela, ambos usam o armazém.
# APEX_DATABASE_URL=postgresql://apex_user:apex_secure_pass@localhost:5432/apex_telemetry

# Motor de domínio em Haskell. Sem ela, as explicações caem no resumo
# determinístico em C++ e /analysis/degradation responde 503.
APEX_STRATEGY_URL=http://127.0.0.1:8092
APEX_STRATEGY_PORT=8092

# auto | v4 | v6. O padrão é v4: em redes dual-stack com AAAA anunciado mas
# inalcançável, a thread de resolução do libcurl fica presa em poll e
# curl_easy_cleanup trava.
APEX_HTTP_IP_FAMILY=v4
APEX_HTTP_TIMEOUT_S=25

# ─── Interface ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ─── Infraestrutura (infra/docker-compose.yml) ─────────────────────────────────
POSTGRES_DB=apex_telemetry
POSTGRES_USER=apex_user
POSTGRES_PASSWORD=apex_secure_pass
GRAFANA_ADMIN_PASSWORD=apex_admin
