cabal-version:      2.4
name:               strategy-hs
version:            2.0.0
synopsis:           Explainable insight and tyre-degradation engine for ApexTelemetry
license:            NONE
author:             ApexTelemetry Engineering
maintainer:         eng@apex-telemetry.io

library
    exposed-modules:
        Apex.Domain.Types
        Apex.Domain.Rules
        Apex.Domain.Degradation
        Apex.Api.Json
        Apex.Api.Server
    build-depends:
        base >=4.14 && <5,
        aeson >=2.0 && <2.3,
        bytestring,
        containers,
        http-types,
        scientific,
        text,
        time,
        vector,
        wai,
        warp
    hs-source-dirs:   src
    default-language: Haskell2010
    default-extensions:
        OverloadedStrings
        DeriveGeneric
        StrictData
    ghc-options:      -Wall -Wcompat

executable strategy-hs
    main-is:          Main.hs
    build-depends:
        base >=4.14 && <5,
        strategy-hs,
        text
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"

test-suite strategy-hs-test
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    build-depends:
        base >=4.14 && <5,
        strategy-hs,
        QuickCheck,
        aeson,
        bytestring,
        text
    hs-source-dirs:   test
    default-language: Haskell2010
