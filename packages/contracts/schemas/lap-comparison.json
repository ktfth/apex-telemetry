{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.apex-telemetry.io/schemas/lap-comparison.json",
  "title": "LapComparison",
  "type": "object",
  "required": [
    "schema_version",
    "session_key",
    "circuit_key",
    "circuit_name",
    "grid_step_m",
    "total_distance_m",
    "reference_lap",
    "comparison_lap",
    "channels",
    "insights",
    "quality_audit"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "session_key": { "type": "integer" },
    "circuit_key": { "type": "integer" },
    "circuit_name": { "type": "string" },
    "grid_step_m": { "type": "number", "minimum": 1.0 },
    "total_distance_m": { "type": "number", "minimum": 100.0 },
    "reference_lap": {
      "type": "object",
      "required": ["driver_number", "driver_code", "lap_number", "lap_time_s", "compound", "stint_lap", "coverage_pct", "samples_count"],
      "properties": {
        "driver_number": { "type": "integer" },
        "driver_code": { "type": "string" },
        "lap_number": { "type": "integer" },
        "lap_time_s": { "type": "number" },
        "compound": { "type": "string", "enum": ["SOFT", "MEDIUM", "HARD", "INTERMEDIATE", "WET", "UNKNOWN"] },
        "stint_lap": { "type": "integer" },
        "coverage_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "samples_count": { "type": "integer" }
      }
    },
    "comparison_lap": {
      "type": "object",
      "required": ["driver_number", "driver_code", "lap_number", "lap_time_s", "compound", "stint_lap", "coverage_pct", "samples_count"],
      "properties": {
        "driver_number": { "type": "integer" },
        "driver_code": { "type": "string" },
        "lap_number": { "type": "integer" },
        "lap_time_s": { "type": "number" },
        "compound": { "type": "string", "enum": ["SOFT", "MEDIUM", "HARD", "INTERMEDIATE", "WET", "UNKNOWN"] },
        "stint_lap": { "type": "integer" },
        "coverage_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "samples_count": { "type": "integer" }
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["distance_m", "ref", "comp", "delta_time_s"],
        "properties": {
          "distance_m": { "type": "number" },
          "delta_time_s": { "type": "number" },
          "ref": { "$ref": "#/$defs/ChannelData" },
          "comp": { "$ref": "#/$defs/ChannelData" }
        }
      }
    },
    "insights": {
      "type": "array",
      "items": { "$ref": "#/$defs/Insight" }
    },
    "quality_audit": {
      "type": "object",
      "required": ["max_interpolation_gap_m", "discontinuous_segments", "confidence_score"],
      "properties": {
        "max_interpolation_gap_m": { "type": "number" },
        "discontinuous_segments": { "type": "integer" },
        "confidence_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    }
  },
  "$defs": {
    "ChannelData": {
      "type": "object",
      "required": ["time_s", "speed_kmh", "throttle_pct", "brake_pct", "rpm", "gear", "drs"],
      "properties": {
        "time_s": { "type": "number" },
        "speed_kmh": { "type": "number" },
        "throttle_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "brake_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "rpm": { "type": "integer" },
        "gear": { "type": "integer", "minimum": 0, "maximum": 8 },
        "drs": { "type": "boolean" }
      }
    },
    "Insight": {
      "type": "object",
      "required": ["id", "driver_code", "distance_start_m", "distance_end_m", "time_loss_s", "summary", "evidence", "assumptions", "limitations", "confidence"],
      "properties": {
        "id": { "type": "string" },
        "driver_code": { "type": "string" },
        "distance_start_m": { "type": "number" },
        "distance_end_m": { "type": "number" },
        "time_loss_s": { "type": "number" },
        "summary": { "type": "string" },
        "evidence": { "type": "object" },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    }
  }
}
